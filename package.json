{
  "name": "dsh-win-notify",
  "version": "1.3.4",
  "description": "DSH plugin: Windows toast notification with sound when an agent task completes.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "assets",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "notification",
    "windows",
    "toast"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MuziIsabel/dsh-win-notify.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime/client"
      ],
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
